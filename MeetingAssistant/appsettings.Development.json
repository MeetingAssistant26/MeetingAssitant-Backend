{

  "Jwt": {
    "Issuer": "MeetingAssistant",
    "Audience": "MeetingAssistantClient",
    "SigningKey": "Set in user-secrets: Jwt:SigningKey",
    "TokenExpiryMinutes": 30
  },
  "Redis": {
    "ConnectionString": "Set in user-secrets: Redis:ConnectionString"
  },
  "AI": {
    "BaseUrl": "Set in user-secrets: AI:BaseUrl",
    "ApiKey": "Set in user-secrets: AI:ApiKey"
  },
  "LiveKit": {
    "BaseUrl": "Set in user-secrets: LiveKit:BaseUrl",
    "ApiKey": "Set in user-secrets: LiveKit:ApiKey",
    "ApiSecret": "Set in user-secrets: LiveKit:ApiSecret"
  },
  "MinIO": {
    "RootUser": "Set in user-secrets: MinIO:RootUser",
    "RootPassword": "Set in user-secrets: MinIO:RootPassword"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
