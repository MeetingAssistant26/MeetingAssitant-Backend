# Copy this file to .env and fill in real values.

POSTGRES_DB=meetingassistant
POSTGRES_USER=meetingassistant
POSTGRES_PASSWORD=replace_with_secure_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

Auth__AutoConfirmNewAccounts=true

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=meetingassistant;Username=meetingassistant;Password=replace_with_secure_password
Jwt__SigningKey=replace_with_minimum_32_char_secret

# ─── Agent API JWT (used by AI debug trace ingestion) ─────
# Required when AiDebug__Enabled=true so dispatch metadata can include an
# agent-scoped JWT. SigningKey must be at least 32 characters.
AgentJwt__SigningKey=replace_with_minimum_32_char_agent_secret
AgentJwt__Issuer=MeetingAssistant
AgentJwt__Audience=MeetingAssistantAgent
AgentJwt__TokenExpiryMinutes=60

# ─── AI assistant debug tracing ───────────────────────────
# Backend feature gate. When false, dispatch metadata omits aiDebug and the
# agent cannot ingest traces even if its local AI_TRACE_ENABLED switch is true.
AiDebug__Enabled=false
AiDebug__PersistPayloads=true

Redis__ConnectionString=redis:6379
AI__ApiKey=replace_with_ai_key
AI__BaseUrl=https://api.openai.com

# ─── LiveKit ─────────────────────────────────────────────
# For LiveKit Cloud: use wss://... ServerUrl and leave EgressHost empty.
LiveKit__ApiKey=devkey
LiveKit__ApiSecret=devsecret_devsecret_devsecret_32chars
LiveKit__ServerUrl=ws://localhost:7880
LiveKit__WebhookSecret=devsecret_devsecret_devsecret_32chars
LiveKit__EgressHost=http://livekit:7880
LiveKit__AgentName=meeting-assistant
LiveKit__AiAssistantDefaultEnabled=true

# ─── Storage (MinIO) ─────────────────────────────────────
Storage__Endpoint=http://minio:9000
Storage__AccessKey=minioadmin
Storage__SecretKey=minioadmin
Storage__Bucket=recordings

# ─── LiveKit Agent / AI worker wiring ──────────────────────
# The combined docker-compose.yml attaches livekit-agent to ../ai_work's
# external ai_work_ai-network. Start ../ai_work first when using the agent.
STT_URL=http://stt:8000/v1
LLM_URL=http://llm:8000/v1
TTS_URL=http://tts:8000/v1

# Backend API URL reachable from livekit-agent for AI debug trace ingestion.
# In this docker-compose.yml, the API service is available as http://api:8080.
BACKEND_AGENT_API_URL=http://api:8080

# Agent-side local kill switch for AI debug tracing. This does not enable
# tracing by itself; backend dispatch metadata must also have AiDebug enabled.
# Set to false/0/no/off to force-disable agent trace emission locally.
AI_TRACE_ENABLED=true

DEPENDENCY_READY_MAX_ATTEMPTS=60
DEPENDENCY_READY_INTERVAL_MS=5000
DEPENDENCY_READY_TIMEOUT_MS=5000
