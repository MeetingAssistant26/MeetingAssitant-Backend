# Copy this file to .env and fill in real values.

POSTGRES_DB=meetingassistant
POSTGRES_USER=meetingassistant
POSTGRES_PASSWORD=replace_with_secure_password

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

Auth__AutoConfirmNewAccounts=true

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=meetingassistant;Username=meetingassistant;Password=replace_with_secure_password
Jwt__SigningKey=replace_with_minimum_32_char_secret

# ─── Agent API JWT (used by AI debug traces and RAG context) ─────
# Required so dispatch metadata can include an agent-scoped JWT for agent-only
# backend endpoints. SigningKey must be at least 32 characters.
AgentJwt__SigningKey=replace_with_minimum_32_char_agent_secret
AgentJwt__Issuer=MeetingAssistant
AgentJwt__Audience=MeetingAssistantAgent
AgentJwt__TokenExpiryMinutes=60

# ─── AI assistant debug tracing ───────────────────────────
# Coherent backend feature gate for AI debug surfaces. When false, dispatch
# metadata omits aiDebug, the agent cannot ingest traces even if its local
# AI_TRACE_ENABLED switch is true, and user-facing post-processing trace reads
# return an empty disabled response.
AiDebug__Enabled=false
AiDebug__PersistPayloads=true

Redis__ConnectionString=redis:6379

# ─── Backend post-meeting AI wiring ──────────────────────
# These defaults target ../ai_work over Docker DNS. The API service is attached
# to ai_work_ai-network by docker-compose.yml; start ../ai_work first.
# The generic AI__* client is retained for legacy callers. Post-meeting STT,
# summarization, action extraction, and backend RAG embeddings use
# OpenAiCompatible__* below.
AI__ApiKey=local-ai-key
AI__BaseUrl=http://llm:8000

# OpenAI-compatible clients used by post-meeting STT and all LLM jobs.
OpenAiCompatible__Stt__BaseUrl=http://stt:8000/v1
OpenAiCompatible__Stt__ApiKey=local-ai-key
OpenAiCompatible__Stt__Model=whisper-1
OpenAiCompatible__Llm__BaseUrl=http://llm:8000/v1
OpenAiCompatible__Llm__ApiKey=local-ai-key
OpenAiCompatible__Llm__Model=local

# RAG embeddings. deterministic-test is the local repeatable provider for tests
# and development. Production should set Provider=openai-compatible, BaseUrl to
# an OpenAI-compatible /v1 endpoint, Model to the embedding model, and Dimension
# to that model's vector length. Backend production RAG does not use ChromaDB or
# local JSON stores.
OpenAiCompatible__Embedding__Provider=deterministic-test
OpenAiCompatible__Embedding__BaseUrl=
OpenAiCompatible__Embedding__ApiKey=local-ai-key
OpenAiCompatible__Embedding__Model=deterministic-test-v1
OpenAiCompatible__Embedding__Dimension=1536

# ─── LiveKit ─────────────────────────────────────────────
# For LiveKit Cloud: use wss://... ServerUrl and leave EgressHost empty.
LiveKit__ApiKey=devkey
LiveKit__ApiSecret=devsecret_devsecret_devsecret_32chars
LiveKit__ServerUrl=ws://localhost:7880
LiveKit__WebhookSecret=devsecret_devsecret_devsecret_32chars
LiveKit__EgressHost=http://livekit:7880
LiveKit__AgentName=meeting-assistant
LiveKit__AiAssistantDefaultEnabled=true

# ─── Storage (MinIO) ─────────────────────────────────────
Storage__Endpoint=http://minio:9000
Storage__AccessKey=minioadmin
Storage__SecretKey=minioadmin
Storage__Bucket=recordings

# ─── LiveKit Agent / AI worker wiring ──────────────────────
# The combined docker-compose.yml attaches livekit-agent to ../ai_work's
# external ai_work_ai-network. Start ../ai_work first when using the agent.
STT_URL=http://stt:8000/v1
LLM_URL=http://llm:8000/v1
TTS_URL=http://tts:8000/v1

# Backend API URL reachable from livekit-agent for AI debug trace ingestion.
# In this docker-compose.yml, the API service is available as http://api:8080.
BACKEND_AGENT_API_URL=http://api:8080

# Backend-owned RAG context retrieval for the LiveKit Agent. When enabled, the
# agent calls /api/agent/meetings/{meetingId}/context/query before LLM replies.
# Auth/config failures fail closed; transient network/backend failures continue
# without RAG context.
AGENT_RAG_ENABLED=true
AGENT_RAG_TOP_K=5
AGENT_RAG_TIMEOUT_MS=2500
AGENT_RAG_MAX_SNIPPETS=5
AGENT_RAG_MAX_SNIPPET_CHARS=900
AGENT_RAG_MAX_TOTAL_CONTEXT_CHARS=3000

# Agent runtime behavior. Preemptive generation is disabled by default so RAG
# context can be fetched and injected before the LLM call. Keepalive must stay
# below LiveKit's TTS-read idle timeout so long LLM streams do not close audio.
AGENT_PREEMPTIVE_GENERATION_ENABLED=false
AGENT_LLM_TIMEOUT_MS=60000
AGENT_TTS_TIMEOUT_MS=30000
AGENT_TTS_KEEPALIVE_MS=1000

# Agent-side local kill switch for AI debug tracing. This does not enable
# tracing by itself; backend dispatch metadata must also have AiDebug enabled.
# Set to false/0/no/off to force-disable agent trace emission locally.
AI_TRACE_ENABLED=true

DEPENDENCY_READY_MAX_ATTEMPTS=60
DEPENDENCY_READY_INTERVAL_MS=5000
DEPENDENCY_READY_TIMEOUT_MS=5000
